{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "website-builder/projects", "-l", "3000", "--no-clipboard"],
      "port": 3000
    },
    {
      "name": "p3-devtalk",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "p3-devtalk", "dev", "--port", "3000"],
      "port": 3000,
      "autoPort": false
    }
    ,
    {
      "name": "p9-church",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": ["/opt/homebrew/bin/pnpm", "--dir", "p9-church", "dev", "--port", "3001"],
      "port": 3001
    }
  ]
}
