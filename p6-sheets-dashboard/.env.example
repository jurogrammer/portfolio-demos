# Google Service Account 이메일 주소
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Google Service Account 프라이빗 키 (base64 인코딩)
# 인코딩 방법: echo -n "키 내용" | base64
# sheets.ts에서 Buffer.from(env, 'base64').toString('utf-8')로 디코딩
GOOGLE_PRIVATE_KEY_BASE64=base64_encoded_private_key_here

# 대상 Google Spreadsheet ID (URL에서 추출)
# https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# 사이트 기본 URL (OG 이미지, 메타데이터용)
NEXT_PUBLIC_SITE_URL=https://p6-sheets-dashboard.vercel.app
